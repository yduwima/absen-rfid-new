# ============================================
# Database Configuration
# ============================================
DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=absensi_rfid
DB_DRIVER=mysqli

# ============================================
# Base URL Configuration
# ============================================
BASE_URL=http://localhost/absen-rfid-new/

# ============================================
# Encryption Key (Generate your own 32 character key)
# ============================================
ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================
# WhatsApp API Configuration
# ============================================
WA_API_URL=https://api.whatsapp.com/send
WA_API_KEY=your-api-key-here
WA_SENDER=628123456789

# ============================================
# Application Settings
# ============================================
APP_ENV=development
APP_DEBUG=true

# ============================================
# Session Configuration
# ============================================
SESSION_DRIVER=files
SESSION_LIFETIME=7200

# ============================================
# Upload Configuration
# ============================================
UPLOAD_MAX_SIZE=2048
ALLOWED_TYPES=jpg|jpeg|png|pdf|xlsx|xls
